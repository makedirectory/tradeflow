# Copy this file to .env and fill in your Alpaca credentials.
# .env is gitignored, so your keys are never committed.
#
# Get free paper-trading keys at https://app.alpaca.markets/
#   -> Paper Account -> API Keys
#
# (No keys needed just to explore — run `make demo` for an offline walkthrough.)

APCA_API_KEY_ID=<APCA_API_KEY_ID>
APCA_API_SECRET_KEY=<APCA_API_SECRET_KEY>

# Keep this true until you are absolutely sure you want to trade real money.
PAPER_TRADE=true


# --- Optional: AI research agent (`python main.py research`) -----------------
# Only needed if you run the research agent. Set the key for the provider you
# use (or export it as a normal environment variable — either works). Ollama
# runs locally and needs no key.
#
#   --provider anthropic (default):  ANTHROPIC_API_KEY   (needs the `ai` extra)
#   --provider openai:               OPENAI_API_KEY      (needs the `openai` extra)
#   --provider ollama (local):       no key; optional OLLAMA_BASE_URL
#
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# OLLAMA_BASE_URL=http://localhost:11434
